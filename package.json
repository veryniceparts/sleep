{
  "name": "sleep-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Sleep apnea monitor: records sounds above a threshold and detects breathing pauses",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:android": "npm run fetch-model && npm run build:web && npx cap sync android && cd android && ./gradlew assembleDebug",
    "fetch-model": "node -e \"const fs=require('fs');fs.mkdirSync('models',{recursive:true});fetch('https://storage.googleapis.com/mediapipe-models/audio_classifier/yamnet/float32/1/yamnet.tflite').then(r=>{if(!r.ok)throw new Error(r.status);return r.arrayBuffer()}).then(b=>fs.writeFileSync('models/yamnet.tflite',Buffer.from(b)))\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@mediapipe/tasks-audio": "1.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
